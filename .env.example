# Copy to .env and fill in. No keys here: every Azure call uses DefaultAzureCredential
# (az login locally, managed identity in production). See docs/decisions/0005-no-keys.md.

# Foundry project and agent
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/oyeva-sales
AGENT_NAME=oyeva-sales-agent
AGENT_MODEL=gpt-4.1-mini

# Storage and search
STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=idx-oyeva-docs

# Content Safety (Prompt Shields) and Content Understanding
CONTENT_SAFETY_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com/
CONTENT_UNDERSTANDING_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/

# Retrieval settings (see docs/decisions/0003)
EMBED_BACKEND=openai            # openai | cohere
RERANK_BACKEND=none             # none | semantic | cohere | jev
FULL_DOC_MAX_TOKENS=8000        # below: whole document in the conversation; above: search
NOT_COVERED_THRESHOLD=          # set from the calibration run, one value per reranker

# Observability (not a data access key, but kept out of the repository)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# CORS
ALLOWED_ORIGINS=http://localhost:5173
